# Copy to .env for local development. Only ModelGate's own .env is read;
# when installed as a plugin, set these in your shell instead.

# At least one vendor key. Vendors with a key are routed in the order anthropic, openai, gemini
# unless MODELGATE_VENDORS sets an order.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Routing order with optional model overrides, e.g. "openai:gpt-5-mini,gemini,anthropic".
# Use "mock" for a free offline demo against eval/dataset.
MODELGATE_VENDORS=

# Monthly spend limit in USD (0 tracks spend without blocking) and the alert threshold.
MODELGATE_BUDGET_USD=5
MODELGATE_BUDGET_WARN_AT=0.8

# Slack-compatible webhook for budget, quota and outage alerts.
MODELGATE_ALERT_WEBHOOK=

# Optional tuning
# MODELGATE_ANTHROPIC_MODEL=claude-opus-5-5
# MODELGATE_OPENAI_MODEL=gpt-5-mini
# MODELGATE_GEMINI_MODEL=gemini-2.5-flash
# MODELGATE_ANTHROPIC_EFFORT=medium
# MODELGATE_TIMEOUT_MS=60000
# MODELGATE_MAX_ATTEMPTS=3
# MODELGATE_BREAKER_THRESHOLD=3
# MODELGATE_BREAKER_COOLDOWN_MS=60000
# MODELGATE_QUOTA_COOLDOWN_MS=900000
# MODELGATE_HOME=.modelgate

# Shared storage. With DATABASE_URL, the API and MCP server share one Postgres
# ledger and usage table; without it, the API uses embedded PGlite in MODELGATE_HOME
# and the MCP server uses local files.
DATABASE_URL=

# API (apps/api): bearer token required in production, and the port.
MODELGATE_API_TOKEN=
PORT=3001

# Web app (apps/web): where the API lives and the token it sends server-side.
MODELGATE_API_URL=http://localhost:3001
